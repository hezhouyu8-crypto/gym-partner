<view class="page">
 <view class="brand">gym partner<text class="brand-dot">●</text></view>
 <view class="subtitle">同城同频，一起练得更好</view>
 <view wx:if="{{!configured}}" class="card notice"><view class="title">即将见面</view><view>云环境尚未配置。完成微信小程序注册并连接云开发后，即可使用真实约练功能。</view></view>
 <view wx:elif="{{!user}}" class="card notice"><view class="title">先认识一下</view><view>去“我的”填写昵称和所在城市，就能发布训练、寻找搭子。</view></view>
 <block wx:if="{{tab === 'discover'}}">
  <view class="section-title">今天，和谁一起练？</view>
  <view class="search"><input value="{{city}}" data-field="city" bindinput="field" placeholder="输入所在城市" maxlength="50"/><button size="mini" bindtap="search" disabled="{{busy || !user}}">找搭子</button></view>
  <scroll-view scroll-x class="filters"><text class="chip {{filter === '全部' ? 'active' : ''}}" data-part="全部" bindtap="setFilter">全部</text><text wx:for="{{parts}}" wx:key="*this" class="chip {{filter === item ? 'active' : ''}}" data-part="{{item}}" bindtap="setFilter">{{item}}</text></scroll-view>
  <view wx:if="{{user && !workouts.length}}" class="empty">还没有合适的训练<view></view>发布你的计划，让搭子找到你</view>
  <view wx:for="{{workouts}}" wx:key="_id" class="card"><view class="row"><text class="avatar">练</text><view><view class="title">{{item.name}}</view><view class="muted">{{item.city}} · {{item.when}}</view></view></view><view class="venue">场馆 · {{item.venue}}</view><view class="parts">今日训练 · {{item.partText}}</view><view class="note">{{item.note}}</view><button wx:if="{{item.userId !== user.id}}" class="primary" data-id="{{item._id}}" bindtap="invite" disabled="{{busy}}">一起训练</button><button wx:else class="secondary" data-id="{{item._id}}" bindtap="removeWorkout" disabled="{{busy}}">删除我的训练</button><view wx:if="{{item.userId !== user.id}}" class="tools"><text data-target="{{item.userId}}" bindtap="report">举报</text><text data-target="{{item.userId}}" bindtap="block">拉黑</text></view></view>
 </block>
 <block wx:if="{{tab === 'publish'}}"><view class="section-title">把今天的计划发出来</view><view class="card"><text class="label">训练场馆</text><input class="input" value="{{venue}}" data-field="venue" bindinput="field" placeholder="例如：超级猩猩 · 静安店" maxlength="100"/><text class="label">所在城市</text><input class="input" value="{{city}}" data-field="city" bindinput="field" placeholder="上海" maxlength="50"/><text class="label">训练部位（最多5项）</text><view class="part-grid"><text wx:for="{{parts}}" wx:key="*this" class="chip {{selectedMap[item] ? 'active' : ''}}" data-part="{{item}}" bindtap="togglePart">{{item}}</text></view><text class="label">训练时间</text><view class="row"><picker mode="date" value="{{date}}" start="{{minDate}}" data-field="date" bindchange="field"><view class="input">{{date}}</view></picker><picker mode="time" value="{{time}}" data-field="time" bindchange="field"><view class="input">{{time}}</view></picker></view><text class="label">想对搭子说</text><textarea class="input textarea" value="{{note}}" data-field="note" bindinput="field" placeholder="训练目标、经验或集合地点…" maxlength="300"/><button class="primary" bindtap="publish" loading="{{busy}}" disabled="{{busy || !user}}">发布训练</button></view></block>
 <block wx:if="{{tab === 'invites'}}"><view class="section-title">我的约练</view><view wx:if="{{!invites.length}}" class="empty">还没有约练<view></view>从一次邀请开始吧</view><view wx:for="{{invites}}" wx:key="_id" class="card"><view class="row between"><text class="title">{{item.otherName}}</text><text class="status">{{item.statusText}}</text></view><view class="venue">场馆 · {{item.venue}}</view><view class="parts">{{item.partText}}</view><view class="muted">{{item.when}}</view><view wx:if="{{item.status === 'pending' && item.receiver === user.id}}" class="row"><button class="primary" data-id="{{item._id}}" data-status="accepted" bindtap="respond" disabled="{{busy}}">接受邀约</button><button class="secondary" data-id="{{item._id}}" data-status="declined" bindtap="respond" disabled="{{busy}}">婉拒</button></view><button wx:if="{{item.status === 'accepted'}}" class="primary" data-id="{{item._id}}" data-name="{{item.otherName}}" bindtap="openChat">聊聊训练安排</button><view class="tools"><text wx:if="{{item.status === 'pending' || item.status === 'accepted'}}" data-id="{{item._id}}" data-status="cancelled" bindtap="respond">取消约练</text><text data-target="{{item.otherId}}" bindtap="report">举报</text><text data-target="{{item.otherId}}" bindtap="block">拉黑</text></view></view></block>
 <block wx:if="{{tab === 'profile'}}"><view class="section-title">我的训练名片</view><view class="card"><text class="label">昵称</text><input class="input" value="{{name}}" data-field="name" bindinput="field" placeholder="让搭子怎么称呼你？" maxlength="30"/><text class="label">所在城市</text><input class="input" value="{{city}}" data-field="city" bindinput="field" placeholder="例如：上海" maxlength="50"/><button class="primary" bindtap="saveProfile" disabled="{{busy || !configured}}" loading="{{busy}}">保存名片</button><view class="muted footnote">通过微信身份识别，无需设置密码。昵称、城市和训练计划会向其他用户展示；聊天仅向邀约双方提供。</view></view><view class="card"><view class="title">安心约练</view><view class="note">优先选择正规公开场馆，按自身能力训练。遇到不当行为，请使用举报或拉黑。</view><view class="muted">测试版 · 正式发布前需配置运营主体、隐私政策及反馈方式</view><button class="secondary" bindtap="deleteAccount" disabled="{{busy || !user}}">删除账号与关联数据</button></view></block>
 <view class="nav"><view class="{{tab === 'discover' ? 'selected' : ''}}" data-tab="discover" bindtap="switchTab">找搭子</view><view class="{{tab === 'publish' ? 'selected' : ''}}" data-tab="publish" bindtap="switchTab">发布</view><view class="{{tab === 'invites' ? 'selected' : ''}}" data-tab="invites" bindtap="switchTab">约练</view><view class="{{tab === 'profile' ? 'selected' : ''}}" data-tab="profile" bindtap="switchTab">我的</view></view>
 <view wx:if="{{chatId}}" class="chat"><view class="chat-head"><text bindtap="closeChat">返回</text><text class="title">{{chatName}}</text></view><scroll-view scroll-y class="chat-messages" scroll-into-view="{{lastMessage}}"><view wx:for="{{messages}}" wx:key="_id" id="msg-{{item._id}}" class="message {{item.mine ? 'mine' : ''}}"><view class="muted">{{item.name}} · {{item.when}}</view><text class="bubble">{{item.body}}</text></view><view wx:if="{{!messages.length}}" class="empty">聊聊训练安排吧</view></scroll-view><view class="chat-send"><input value="{{message}}" data-field="message" bindinput="field" placeholder="发送消息" maxlength="1000"/><button class="primary" size="mini" bindtap="send" disabled="{{busy}}">发送</button></view></view>
</view>

page{background:#FAF8F5;color:#253444;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx}button{font-size:28rpx;border-radius:22rpx}button::after{border:0}.page{padding:40rpx 32rpx 180rpx}.brand{font-size:48rpx;font-weight:800;letter-spacing:-2rpx}.brand-dot{color:#F47756;font-size:22rpx;margin-left:12rpx}.subtitle{color:#8b929a;margin:12rpx 0 44rpx}.section-title{font-size:38rpx;font-weight:700;margin:28rpx 0}.card{background:#fff;border:1rpx solid #eee9e3;border-radius:30rpx;padding:30rpx;margin:24rpx 0;box-shadow:0 10rpx 40rpx #25344405}.notice{line-height:1.8;color:#687681}.title{font-weight:700;font-size:32rpx}.row{display:flex;align-items:center;gap:22rpx}.between{justify-content:space-between}.avatar{display:flex;align-items:center;justify-content:center;background:#fff0e9;color:#e57253;width:80rpx;height:80rpx;border-radius:28rpx;font-weight:700}.muted{color:#89939c;font-size:24rpx;line-height:1.7}.venue{font-weight:600;margin:26rpx 0 14rpx}.parts{color:#e17151;font-size:26rpx}.note{line-height:1.7;margin:18rpx 0 26rpx;color:#6b7681}.primary{background:#F47756;color:#fff;margin:24rpx 0 0;flex:1}.secondary{background:#f1f2f2;color:#53616f;margin:24rpx 0 0;flex:1}.primary[disabled]{background:#efc7bb;color:#fff}.search,.chat-send{display:flex;align-items:center;gap:20rpx;background:#fff;border-radius:22rpx;padding:14rpx 20rpx}.search input,.chat-send input{flex:1;min-width:0}.search button{background:#253444;color:#fff}.filters{white-space:nowrap;margin:28rpx 0}.chip{display:inline-block;padding:14rpx 24rpx;background:#efede9;border-radius:40rpx;font-size:25rpx;margin:0 14rpx 14rpx 0}.chip.active{background:#253444;color:#fff}.part-grid{margin:14rpx 0}.label{display:block;font-weight:600;margin:28rpx 0 14rpx}.input{box-sizing:border-box;width:100%;background:#f7f6f3;padding:24rpx;border-radius:18rpx;min-height:84rpx}.textarea{height:180rpx}.row picker{flex:1}.tools{display:flex;gap:28rpx;color:#8c959d;font-size:24rpx;margin-top:26rpx}.status{color:#e17151;font-size:24rpx}.empty{text-align:center;color:#9aa0a4;padding:70rpx 20rpx;line-height:2}.nav{position:fixed;bottom:0;left:0;right:0;background:#fff;display:flex;justify-content:space-around;padding:26rpx 0 calc(26rpx + env(safe-area-inset-bottom));border-top:1rpx solid #eee9e3;z-index:5}.nav view{color:#8d959c;padding:12rpx 22rpx}.nav .selected{color:#e17151;font-weight:700;background:#fff0e9;border-radius:24rpx}.footnote{margin-top:30rpx}.chat{position:fixed;top:0;right:0;bottom:0;left:0;background:#FAF8F5;z-index:10;display:flex;flex-direction:column;padding:24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));box-sizing:border-box}.chat-head{display:flex;align-items:center;gap:40rpx;padding:18rpx 0 28rpx}.chat-messages{flex:1;min-height:0;height:0}.message{margin:22rpx 0;text-align:left}.message.mine{text-align:right}.bubble{display:inline-block;max-width:85%;white-space:pre-wrap;word-break:break-all;background:#fff;border-radius:20rpx;padding:22rpx;margin-top:10rpx;text-align:left}.mine .bubble{background:#ffe4d9}.chat-send .primary{flex:none;margin:0}
